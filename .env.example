# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# Bot Settings
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# Roles & Channels (IDs)
VERIFIED_ROLE_ID=
STAFF_ROLE_ID=
MODERATOR_ROLE_ID=
ADMIN_ROLE_ID=

LOGS_CHANNEL_ID=
APPLICATIONS_CHANNEL_ID=
TICKETS_CHANNEL_ID=
WELCOME_CHANNEL_ID=

# Whitelist Settings
WHITELIST_ENABLED=true
AUTO_APPROVE_ENABLED=false

# Bot Prefix (for text commands if needed)
PREFIX=!
